+theorem smoothCotangentPresentation {X S : Scheme} (s : X ⟶ S) (d : ℕ)
+    (hs : SmoothOfRelativeDimension d s) :
+    ∃ P : CotangentPresentation s, IsLocallyFreeOfRank P.object d := by
