import Mathlib

/-!
## Suitable lines: regular arcs and the pole-order contradiction

SOURCE: the pinned OpenAI manuscript, `lines:cone-addition` and
`lines:rescaling`. These are algebraic deductions from explicitly supplied
local-ring and arc data. They do not assert existence of the curve in a
positive-dimensional addition fiber, its projective completion, a pole,
or the comparison of the smooth cone germ with its completed local ring.

The coefficient proof below retains the strict inequality `2*k < 3*k`.
It never treats a quadratic vanishing estimate as a cubic one, and it
works with both arguments varying through the actual diagonal ideal.

STATUS: new source; compilation deferred by the user's 35,000-line gate.
-/

noncomputable section
set_option autoImplicit false

open scoped BigOperators

namespace LeBrunSalamon.Construction.Lines.ConePole

abbrev Series := PowerSeries ℂ

/-- The actual principal ideal of series vanishing to order at least `k`. -/
def orderIdeal (k : ℕ) : Ideal Series :=
  Ideal.span {(PowerSeries.X : Series) ^ k}

theorem mem_orderIdeal_iff_dvd (k : ℕ) (f : Series) :
    f ∈ orderIdeal k ↔ (PowerSeries.X : Series) ^ k ∣ f :=
  Ideal.mem_span_singleton

/-- A coefficient test, including `k = 0` and the zero series. -/
theorem mem_orderIdeal_iff_coeff (k : ℕ) (f : Series) :
    f ∈ orderIdeal k ↔ ∀ m : ℕ, m < k → PowerSeries.coeff m f = 0 :=
  (mem_orderIdeal_iff_dvd k f).trans PowerSeries.X_pow_dvd_iff

theorem orderIdeal_pow (k r : ℕ) :
    orderIdeal k ^ r = orderIdeal (k * r) := by
  unfold orderIdeal
  rw [Ideal.span_singleton_pow, ← pow_mul]

theorem coeff_eq_zero_of_mem_orderIdeal {k m : ℕ} {f : Series}
    (hf : f ∈ orderIdeal k) (hm : m < k) : PowerSeries.coeff m f = 0 :=
  (mem_orderIdeal_iff_coeff k f).mp hf m hm

/-- Any positive order of the difference forces the same special value. -/
theorem constantCoeff_eq_of_sub_mem {k : ℕ} (hk : 0 < k)
    {f g : Series} (hfg : f - g ∈ orderIdeal k) :
    PowerSeries.constantCoeff f = PowerSeries.constantCoeff g := by
  have h := coeff_eq_zero_of_mem_orderIdeal hfg hk
  rw [PowerSeries.coeff_zero_eq_constantCoeff_apply, map_sub] at h
  exact sub_eq_zero.mp h

/-- Ideal powers commute with the stated order estimate under an actual
ring homomorphism. No assumption about a chosen formal coordinate system
is hidden in this lemma. -/
theorem pullback_power_mem {A : Type*} [CommRing A]
    (I : Ideal A) (φ : A →+* Series) (k r : ℕ)
    (hφ : ∀ a ∈ I, φ a ∈ orderIdeal k)
    {f : A} (hf : f ∈ I ^ r) : φ f ∈ orderIdeal (k * r) := by
  have hI : I ≤ (orderIdeal k).comap φ := hφ
  have hp : I ^ r ≤ (orderIdeal k ^ r).comap φ :=
    (Ideal.pow_right_mono hI r).trans (Ideal.le_comap_pow φ r)
  have hmem : φ f ∈ orderIdeal k ^ r := hp hf
  simpa only [orderIdeal_pow] using hmem

/-- The ideal generated by the differences of the specified two lists
of regular functions. Equality with the full diagonal ideal is a
separate geometric claim whenever these are merely local coordinates. -/
def differenceIdeal {A : Type*} [CommRing A] {ι : Type*}
    (left right : ι → A) : Ideal A :=
  Ideal.span (Set.range (fun i => left i - right i))

theorem difference_mem {A : Type*} [CommRing A] {ι : Type*}
    (left right : ι → A) (i : ι) :
    left i - right i ∈ differenceIdeal left right :=
  Ideal.subset_span ⟨i, rfl⟩

theorem differenceIdeal_le_comap {A : Type*} [CommRing A] {ι : Type*}
    (left right : ι → A) (φ : A →+* Series) (k : ℕ)
    (h : ∀ i, φ (left i) - φ (right i) ∈ orderIdeal k) :
    differenceIdeal left right ≤ (orderIdeal k).comap φ := by
  apply Ideal.span_le.mpr
  rintro _ ⟨i, rfl⟩
  change φ (left i - right i) ∈ orderIdeal k
  rw [map_sub]
  exact h i

theorem pullback_difference_power {A : Type*} [CommRing A] {ι : Type*}
    (left right : ι → A) (φ : A →+* Series) (k r : ℕ)
    (h : ∀ i, φ (left i) - φ (right i) ∈ orderIdeal k)
    {f : A} (hf : f ∈ differenceIdeal left right ^ r) :
    φ f ∈ orderIdeal (k * r) :=
  pullback_power_mem (differenceIdeal left right) φ k r
    (differenceIdeal_le_comap left right φ k h) hf

/-- The coordinate congruence in `lines:rescaling` supplies divisibility
by the full pole order, with no division of a regular series. -/
theorem difference_mem_of_rescaling {ι : Type*}
    (p q : ι → Series) (s : ι → ℂ) (k : ℕ)
    (h : ∀ i, p i - q i = (PowerSeries.X : Series) ^ k * PowerSeries.C (s i)) :
    ∀ i, p i - q i ∈ orderIdeal k := by
  intro i
  apply (mem_orderIdeal_iff_dvd k _).mpr
  exact ⟨PowerSeries.C (s i), h i⟩

theorem same_special_value_of_rescaling {ι : Type*}
    (p q : ι → Series) (s : ι → ℂ) (k : ℕ) (hk : 0 < k)
    (h : ∀ i, p i - q i = (PowerSeries.X : Series) ^ k * PowerSeries.C (s i)) :
    (fun i => PowerSeries.constantCoeff (p i)) =
      (fun i => PowerSeries.constantCoeff (q i)) := by
  funext i
  exact constantCoeff_eq_of_sub_mem hk (difference_mem_of_rescaling p q s k h i)

/-- Passing to local coordinates which are restrictions of ambient
linear functions preserves the complete `t^k` congruence. -/
theorem linear_coordinate_sub_mem {ι : Type*} [Fintype ι]
    (c : ι → ℂ) (p q : ι → Series) (k : ℕ)
    (h : ∀ i, p i - q i ∈ orderIdeal k) :
    (∑ i, PowerSeries.C (c i) * p i) -
      (∑ i, PowerSeries.C (c i) * q i) ∈ orderIdeal k := by
  rw [← Finset.sum_sub_distrib]
  apply Ideal.sum_mem
  intro i _
  rw [← mul_sub]
  exact (orderIdeal k).mul_mem_left _ (h i)

/-- Exact coefficient obstruction: a nonzero coefficient in degree `d`
is incompatible with membership in `(t^e)` when `d < e`. -/
theorem monomial_not_mem_orderIdeal (c : ℂ) (hc : c ≠ 0)
    {d e : ℕ} (hde : d < e) :
    PowerSeries.C c * (PowerSeries.X : Series) ^ d ∉ orderIdeal e := by
  intro h
  have hz := coeff_eq_zero_of_mem_orderIdeal h hde
  exact hc (by simpa [PowerSeries.coeff_C_mul_X_pow] using hz)

theorem neg_monomial_not_mem_orderIdeal (c : ℂ) (hc : c ≠ 0)
    {d e : ℕ} (hde : d < e) :
    -(PowerSeries.C c * (PowerSeries.X : Series) ^ d) ∉ orderIdeal e := by
  intro h
  apply monomial_not_mem_orderIdeal c hc hde
  simpa only [neg_neg] using (orderIdeal e).neg_mem h

/-- The final numerical contradiction in `lines:cone-addition`. -/
theorem double_order_not_triple (k : ℕ) (hk : 0 < k)
    (c : ℂ) (hc : c ≠ 0) :
    -(PowerSeries.C c * (PowerSeries.X : Series) ^ (2 * k)) ∉
      orderIdeal (3 * k) :=
  neg_monomial_not_mem_orderIdeal c hc (by omega)

/-- A unit factor gives the same obstruction; this version is independent
of the choice of uniformizer used to express the nonzero leading term. -/
theorem leading_unit_not_mem (u : Series)
    (hu : PowerSeries.constantCoeff u ≠ 0)
    {d e : ℕ} (hde : d < e) :
    (PowerSeries.X : Series) ^ d * u ∉ orderIdeal e := by
  intro h
  have hz := coeff_eq_zero_of_mem_orderIdeal h hde
  have hcoeff : PowerSeries.coeff d ((PowerSeries.X : Series) ^ d * u) =
      PowerSeries.constantCoeff u := by
    simpa only [zero_add, add_zero, PowerSeries.coeff_zero_eq_constantCoeff_apply] using
      (PowerSeries.coeff_X_pow_mul u d 0)
  exact hu (hcoeff.symm.trans hz)

/-- The local-ring form of the manuscript's contradiction. Both the
cubic diagonal membership and its pullback order are used explicitly. -/
theorem cubic_pullback_contradiction {A : Type*} [CommRing A]
    (I : Ideal A) (φ : A →+* Series) (k : ℕ) (hk : 0 < k)
    (hφ : ∀ a ∈ I, φ a ∈ orderIdeal k)
    (f : A) (hf : f ∈ I ^ 3) (c : ℂ) (hc : c ≠ 0)
    (hexact : φ f = -(PowerSeries.C c * (PowerSeries.X : Series) ^ (2 * k))) :
    False := by
  have horder := pullback_power_mem I φ k 3 hφ hf
  rw [hexact] at horder
  exact double_order_not_triple k hk c hc (by simpa only [Nat.mul_comm] using horder)

/-- A useful interface when a specific list of regular coordinate
differences has already been proved to generate the needed ideal. -/
theorem cubic_difference_contradiction {A : Type*} [CommRing A] {ι : Type*}
    (left right : ι → A) (φ : A →+* Series) (k : ℕ) (hk : 0 < k)
    (h : ∀ i, φ (left i) - φ (right i) ∈ orderIdeal k)
    (f : A) (hf : f ∈ differenceIdeal left right ^ 3)
    (c : ℂ) (hc : c ≠ 0)
    (hexact : φ f = -(PowerSeries.C c * (PowerSeries.X : Series) ^ (2 * k))) :
    False :=
  cubic_pullback_contradiction (differenceIdeal left right) φ k hk
    (differenceIdeal_le_comap left right φ k h) f hf c hc hexact

end LeBrunSalamon.Construction.Lines.ConePole

namespace LeBrunSalamon.Construction.Lines.ConePairing

variable {ι : Type*} [Fintype ι]

/-- The scalar extension of a specified complex bilinear form, expressed
in actual ambient coordinates. This is a regular function on any pair of
affine cones after the coordinate functions are substituted. -/
def pairing {A : Type*} [CommRing A] [Algebra ℂ A]
    (ω : ι → ι → ℂ) (a b : ι → A) : A :=
  ∑ i, ∑ j, a i * algebraMap ℂ A (ω i j) * b j

theorem pairing_map {A B : Type*} [CommRing A] [Algebra ℂ A]
    [CommRing B] [Algebra ℂ B] (φ : A →ₐ[ℂ] B)
    (ω : ι → ι → ℂ) (a b : ι → A) :
    φ (pairing ω a b) = pairing ω (fun i => φ (a i)) (fun i => φ (b i)) := by
  simp only [pairing, map_sum, map_mul, φ.commutes]

theorem pairing_zero_left {A : Type*} [CommRing A] [Algebra ℂ A]
    (ω : ι → ι → ℂ) (b : ι → A) : pairing ω (fun _ => 0) b = 0 := by
  simp [pairing]

theorem pairing_zero_right {A : Type*} [CommRing A] [Algebra ℂ A]
    (ω : ι → ι → ℂ) (a : ι → A) : pairing ω a (fun _ => 0) = 0 := by
  simp [pairing]

theorem pairing_neg_left {A : Type*} [CommRing A] [Algebra ℂ A]
    (ω : ι → ι → ℂ) (a b : ι → A) :
    pairing ω (fun i => -a i) b = -pairing ω a b := by
  simp [pairing, Finset.sum_neg_distrib]

theorem pairing_neg_right {A : Type*} [CommRing A] [Algebra ℂ A]
    (ω : ι → ι → ℂ) (a b : ι → A) :
    pairing ω a (fun i => -b i) = -pairing ω a b := by
  simp [pairing, Finset.sum_neg_distrib]

theorem pairing_scale {A : Type*} [CommRing A] [Algebra ℂ A]
    (ω : ι → ι → ℂ) (r s : A) (a b : ι → A) :
    pairing ω (fun i => r * a i) (fun i => s * b i) =
      (r * s) * pairing ω a b := by
  unfold pairing
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro i _
  rw [Finset.mul_sum]
  apply Finset.sum_congr rfl
  intro j _
  ring

/-- The sign on `q = -t^k b` is retained. -/
theorem pairing_rescale_opposite {A : Type*} [CommRing A] [Algebra ℂ A]
    (ω : ι → ι → ℂ) (r : A) (a b : ι → A) :
    pairing ω (fun i => r * a i) (fun i => -(r * b i)) =
      -(r ^ 2 * pairing ω a b) := by
  rw [pairing_neg_right, pairing_scale]
  simp only [pow_two]

theorem pairing_skew {A : Type*} [CommRing A] [Algebra ℂ A]
    (ω : ι → ι → ℂ) (hω : ∀ i j, ω i j = -ω j i) (a b : ι → A) :
    pairing ω a b = -pairing ω b a := by
  unfold pairing
  rw [Finset.sum_comm]
  simp only [← Finset.sum_neg_distrib]
  apply Finset.sum_congr rfl
  intro j _
  apply Finset.sum_congr rfl
  intro i _
  rw [hω i j, map_neg]
  ring

/-- Differentiation uses the given derivation on the actual coefficient
ring, so it applies to regular functions and to rational functions. -/
theorem derivative_pairing {A : Type*} [CommRing A] [Algebra ℂ A]
    (D : Derivation ℂ A A) (ω : ι → ι → ℂ) (a b : ι → A) :
    D (pairing ω a b) =
      pairing ω (fun i => D (a i)) b + pairing ω a (fun i => D (b i)) := by
  unfold pairing
  simp only [map_sum, ← Finset.sum_add_distrib]
  apply Finset.sum_congr rfl
  intro i _
  apply Finset.sum_congr rfl
  intro j _
  simp only [D.leibniz, D.map_algebraMap, smul_eq_mul]
  ring

/-- For a fixed-sum family, both radial-isotropy identities kill the
derivative of the cross pairing. The tangent identities are explicit;
their geometric source is the Lagrangian cone tangent space. -/
theorem derivative_pairing_eq_zero_of_fixed_sum
    {A : Type*} [CommRing A] [Algebra ℂ A]
    (D : Derivation ℂ A A) (ω : ι → ι → ℂ) (a b : ι → A)
    (hfixed : ∀ i, D (a i) + D (b i) = 0)
    (ha : pairing ω a (fun i => D (a i)) = 0)
    (hb : pairing ω (fun i => D (b i)) b = 0) :
    D (pairing ω a b) = 0 := by
  have hab : (fun i => D (a i)) = (fun i => -D (b i)) := by
    funext i
    exact eq_neg_of_add_eq_zero_left (hfixed i)
  have hba : (fun i => D (b i)) = (fun i => -D (a i)) := by
    funext i
    exact eq_neg_of_add_eq_zero_right (hfixed i)
  rw [derivative_pairing]
  have hfirst : pairing ω (fun i => D (a i)) b = 0 := by
    rw [hab, pairing_neg_left, hb, neg_zero]
  have hsecond : pairing ω a (fun i => D (b i)) = 0 := by
    rw [hba, pairing_neg_right, ha, neg_zero]
  rw [hfirst, hsecond, add_zero]

theorem fixed_sum_derivative {A : Type*} [CommRing A] [Algebra ℂ A]
    (D : Derivation ℂ A A) (a b : ι → A) (s : ι → ℂ)
    (h : ∀ i, a i + b i = algebraMap ℂ A (s i)) :
    ∀ i, D (a i) + D (b i) = 0 := by
  intro i
  have hi := congrArg D (h i)
  simpa only [map_add, D.map_algebraMap] using hi

/-- The completed-disc version of the characteristic-zero constant
function calculation. This does not replace the still-needed theorem
about constants in the function field of an integral algebraic curve. -/
theorem formal_pairing_constant (ω : ι → ι → ℂ)
    (a b : ι → ConePole.Series)
    (hfixed : ∀ i, PowerSeries.derivative (a i) + PowerSeries.derivative (b i) = 0)
    (ha : pairing ω a (fun i => PowerSeries.derivative (a i)) = 0)
    (hb : pairing ω (fun i => PowerSeries.derivative (b i)) b = 0) :
    pairing ω a b = PowerSeries.C (PowerSeries.constantCoeff (pairing ω a b)) := by
  apply PowerSeries.derivative.ext
  · rw [derivative_pairing_eq_zero_of_fixed_sum PowerSeries.derivative ω a b hfixed ha hb,
      PowerSeries.derivative_C]
  · simp

/-- Meromorphic vectors may live in a fraction field, while their
rescalings live in the actual regular power-series ring. Injectivity of
the stated inclusion transports the exact pairing identity back. -/
theorem regular_rescaling_pairing {K : Type*} [CommRing K] [Algebra ℂ K]
    (j : ConePole.Series →ₐ[ℂ] K) (hj : Function.Injective j)
    (ω : ι → ι → ℂ) (a b : ι → K) (p q : ι → ConePole.Series)
    (k : ℕ) (c : ℂ)
    (hp : ∀ i, j (p i) = j (PowerSeries.X : ConePole.Series) ^ k * a i)
    (hq : ∀ i, j (q i) = -(j (PowerSeries.X : ConePole.Series) ^ k * b i))
    (hpair : pairing ω a b = algebraMap ℂ K c) :
    pairing ω p q = -(PowerSeries.C c * (PowerSeries.X : ConePole.Series) ^ (2 * k)) := by
  apply hj
  rw [pairing_map]
  have hp' := funext hp
  have hq' := funext hq
  rw [hp', hq', pairing_rescale_opposite, hpair]
  have hc : j (PowerSeries.C c) = algebraMap ℂ K c := j.commutes c
  simp only [map_neg, map_mul, map_pow, hc]
  rw [← pow_mul]
  congr 1
  rw [Nat.mul_comm k 2, mul_comm]

/-- The exact rescaling formula plus cubic diagonal vanishing excludes
the proposed nonorthogonal pole arc. All geometric comparison data are
visible in the hypotheses; no dominance conclusion is assumed. -/
theorem no_nonorthogonal_rescaled_arc
    {A K : Type*} [CommRing A] [CommRing K] [Algebra ℂ K]
    (I : Ideal A) (φ : A →+* ConePole.Series)
    (j : ConePole.Series →ₐ[ℂ] K) (hj : Function.Injective j)
    (ω : ι → ι → ℂ) (a b : ι → K) (p q : ι → ConePole.Series)
    (k : ℕ) (hk : 0 < k) (c : ℂ) (hc : c ≠ 0)
    (hp : ∀ i, j (p i) = j (PowerSeries.X : ConePole.Series) ^ k * a i)
    (hq : ∀ i, j (q i) = -(j (PowerSeries.X : ConePole.Series) ^ k * b i))
    (hpair : pairing ω a b = algebraMap ℂ K c)
    (hφ : ∀ z ∈ I, φ z ∈ ConePole.orderIdeal k)
    (f : A) (hf : f ∈ I ^ 3) (hfunction : φ f = pairing ω p q) : False := by
  apply ConePole.cubic_pullback_contradiction I φ k hk hφ f hf c hc
  exact hfunction.trans (regular_rescaling_pairing j hj ω a b p q k c hp hq hpair)

end LeBrunSalamon.Construction.Lines.ConePairing

end
