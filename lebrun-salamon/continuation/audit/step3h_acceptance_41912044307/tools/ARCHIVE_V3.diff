+def same_artifact_metadata(actual, expected):
+    """Allow only GitHub's optional, ID-checked GraphQL node identifier.
+
+    Both raw metadata documents and their hashes remain evidence. Every other
+    field, including missing/extra keys and JSON value types, must match.
+    """
+    need(type(actual) is dict and type(expected) is dict and
+         type(expected.get("id")) is int and expected["id"] > 0,
+         "Malformed expected artifact identity")
+    identity = f"08:Artifact{expected['id']}".encode("ascii")
+    def without_checked_node(meta):
+        out = dict(meta)
+        if "node_id" in out:
+            node = out.pop("node_id")
+            need(type(node) is str, "Artifact node_id is not a string")
+            try:
+                decoded = base64.b64decode(node, validate=True)
+            except (ValueError, TypeError):
+                raise ValueError("Malformed artifact node_id encoding")
+            need(decoded == identity and base64.b64encode(decoded).decode("ascii") == node,
+                 "Artifact node_id does not encode the exact expected artifact ID")
+        return out
+    return json.dumps(without_checked_node(actual), sort_keys=True, separators=(",", ":")) == \
+        json.dumps(without_checked_node(expected), sort_keys=True, separators=(",", ":"))
 
 
