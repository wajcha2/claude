import RecompileExtensionsPart04Geometry

/-! The actual quotient-tuple algebra for the Segre hyperplane section.
The four coordinates are (z₂,z₀,z₁,δz₂). Generation is transported by
explicit finite-coproduct maps, and the determinant equation is the original
line-valued conic equation. No reducedness or pointwise detection is used.
No admission. -/

noncomputable section
set_option autoImplicit false
set_option backward.isDefEq.respectTransparency false
set_option backward.isDefEq.respectTransparency.types false

open CategoryTheory CategoryTheory.Limits AlgebraicGeometry
open LeBrunSalamon.PhaseOne LeBrunSalamon.PhaseTwo LeBrunSalamon.PhaseThree
open LeBrunSalamon.PhaseTwentyFive LeBrunSalamon.PhaseTwentySix
open LeBrunSalamon.PhaseTwentyEight
open LeBrunSalamon.Skeleton
open LeBrunSalamon.Construction.Smoothing.CoordinateCharts

namespace LeBrunSalamon.ConicGeneratingTuples

def scale {Y : Scheme} {E : OModule Y} (r : RingSections Y ⊤)
    (s : AlgebraicSection E) : AlgebraicSection E :=
  sectionFromValue (r • sectionValue s)

theorem scalar_precompose {Y : Scheme} {E : OModule Y}
    (r : RingSections Y ⊤) (s : AlgebraicSection E) :
    scalarSection r ≫ s = scale r s := by
  apply (sectionValue_bijective E).injective
  rw [sectionValue_comp, scalarSection, sectionFromValue_spec,
    scale, sectionFromValue_spec]
  have h := Scheme.Modules.Hom.app_smul s r (1 : RingSections Y ⊤)
  simpa only [smul_eq_mul, mul_one, sectionValue] using h

theorem tensor_scale_right {Y : Scheme} {E F : OModule Y}
    (r : RingSections Y ⊤) (s : AlgebraicSection E) (t : AlgebraicSection F) :
    tensorSection s (scale r t) = scale r (tensorSection s t) := by
  apply (sectionValue_bijective (tensorSheaf E F)).injective
  simp only [scale, sectionValue_tensorSection, sectionFromValue_spec, map_smul]

def quadruple {Y : Scheme} {E : OModule Y}
    (a : Fin 3 → AlgebraicSection E) (r : RingSections Y ⊤) :
    Fin 4 → AlgebraicSection E := ![a 2, a 0, a 1, scale r (a 2)]

/-- The original three generating sections are among the four Segre
coordinates. The proof is an explicit factorization of their quotient map. -/
theorem quadruple_generates {Y : Scheme} (L : LineBundle Y)
    (a : Fin 3 → AlgebraicSection L.sheaf) (r : RingSections Y ⊤)
    (ha : TupleGenerates L a) : TupleGenerates L (quadruple a r) := by
  let u : (∐ fun _ : Fin 3 => structureModule Y) ⟶
      (∐ fun _ : Fin 4 => structureModule Y) :=
    Sigma.desc (fun i => Sigma.ι (fun _ : Fin 4 => structureModule Y) (![1, 2, 0] i))
  have hfac : u ≫ Sigma.desc (quadruple a r) = Sigma.desc a := by
    apply Sigma.hom_ext
    intro i
    fin_cases i <;> simp [u, quadruple]
  letI : Epi (Sigma.desc a) := ha
  exact epi_of_epi_fac hfac

/-- Conversely, the fourth coordinate is a multiple of the first, so
the same actual line is generated by the original three coordinates. -/
theorem generates_of_quadruple {Y : Scheme} (L : LineBundle Y)
    (a : Fin 3 → AlgebraicSection L.sheaf) (r : RingSections Y ⊤)
    (ha : TupleGenerates L (quadruple a r)) : TupleGenerates L a := by
  let ι := fun i : Fin 3 => Sigma.ι (fun _ : Fin 3 => structureModule Y) i
  let u : (∐ fun _ : Fin 4 => structureModule Y) ⟶
      (∐ fun _ : Fin 3 => structureModule Y) :=
    Sigma.desc ![ι 2, ι 0, ι 1, scalarSection r ≫ ι 2]
  have hfac : u ≫ Sigma.desc a = Sigma.desc (quadruple a r) := by
    apply Sigma.hom_ext
    intro i
    fin_cases i <;> simp [u, ι, quadruple, Category.assoc, scalar_precompose]
    exact scalar_precompose r (a 2)
  letI : Epi (Sigma.desc (quadruple a r)) := ha
  exact epi_of_epi_fac hfac

/-- The determinant vanishes as an equality in the tensor square of the
original line sheaf, not merely after evaluating at geometric points. -/
theorem quadruple_equation {Y : Scheme} {E : OModule Y}
    (a : Fin 3 → AlgebraicSection E) (r : RingSections Y ⊤)
    (h : tensorSection (a 0) (a 1) = scale r (tensorSection (a 2) (a 2))) :
    tensorSection (quadruple a r 0) (quadruple a r 3) =
      tensorSection (quadruple a r 1) (quadruple a r 2) := by
  change tensorSection (a 2) (scale r (a 2)) = tensorSection (a 0) (a 1)
  rw [tensor_scale_right]
  exact h.symm

theorem quadruple_pull {X Y : Scheme} (f : X ⟶ Y) {E : OModule Y}
    (a : Fin 3 → AlgebraicSection E) (r : RingSections Y ⊤) (i : Fin 4) :
    pullSection f (quadruple a r i) =
      quadruple (fun j => pullSection f (a j)) (f.appTop r) i := by
  fin_cases i <;> simp [quadruple, scale,
    LeBrunSalamon.Construction.Smoothing.StandardSourceProof.pullSection_scalar]

end LeBrunSalamon.ConicGeneratingTuples
end
